# ========================
# SCENTINEL - Environment Variables Example
# Copy to .env and fill in your values
# ========================

# --- PostgreSQL ---
POSTGRES_USER=scentinel
POSTGRES_PASSWORD=scentinel_secret
POSTGRES_DB=scentinel_db
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Backend ---
SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ESP32_API_KEY=esp32-static-api-key-change-this

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost/api
NEXT_PUBLIC_SSE_URL=http://localhost/api/stream

# --- Nginx ---
NGINX_HOST=localhost
