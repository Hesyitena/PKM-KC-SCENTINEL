# ========================
# SCENTINEL - .gitignore
# ========================

# Environment variables
.env
.env.local
.env.production
.env.*.local

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
venv/
env/
.venv/
*.pyc

# Node.js
node_modules/
.next/
out/
.turbo/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Docker
.docker/

# IDE
.vscode/
.idea/
*.swp
*.swo
*.DS_Store

# Database
*.db
*.sqlite3

# Logs
logs/
*.log

# Coverage
htmlcov/
.coverage
.coverage.*
coverage.xml
*.cover

# AI
.playwright-mcp/
.agents/
.clinerules
.cursor/
.cursorrules
.copilot-instructions.md
.opencode/
.windsurf/
.qoder/
.github/copilot-instructions.md
.superpowers/
.claude/
.agents/

# ML artefacts too large or regenerable for git — the notebook,
# datasets, and firmware sketches under ml/ ARE tracked.
ml/models/*.pkl
ml/models/*.joblib
ml/**/__pycache__/
ml/**/.ipynb_checkpoints/
